{
  "name": "robotics-intelligence",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "db:reset": "pnpm --filter @ri/db reset",
    "db:migrate": "pnpm --filter @ri/db migrate",
    "seed": "pnpm --filter @ri/seed run seed",
    "fixtures": "pnpm --filter @ri/fixtures generate",
    "queries": "pnpm --filter @ri/api queries",
    "check": "pnpm -r typecheck && pnpm -r test"
  },
  "devDependencies": { "typescript": "^5.6.0", "vitest": "^2.1.0" }
}
