{
  "name": "robotics-intelligence",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "db:reset": "pnpm --filter @ri/db reset",
    "db:migrate": "pnpm --filter @ri/db migrate",
    "seed": "pnpm --filter @ri/seed run seed",
    "fixtures": "pnpm --filter @ri/fixtures generate",
    "queries": "pnpm --filter @ri/api queries",
    "dev:api": "pnpm --filter @ri/api dev:api",
    "ingest:fetch": "pnpm --filter @ri/ingestion run fetch",
    "check": "pnpm -r typecheck && vitest run"
  },
  "devDependencies": { "@types/node": "^22.15.0", "dotenv": "^16.4.5", "tsx": "^4.19.0", "typescript": "~5.9.3", "vitest": "^3.2.7" }
}
